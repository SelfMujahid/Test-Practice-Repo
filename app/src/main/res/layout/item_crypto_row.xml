<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <!-- # Rank (Width: 35dp) -->
    <TextView
        android:id="@+id/tvRank"
        android:layout_width="35dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:text="1"
        android:textColor="#888888"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Name & Logo (Width: 120dp) -->
    <LinearLayout
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgCoinLogo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/ic_menu_gallery" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCoinSymbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BTC"
                android:textColor="#111111"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCoinName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Bitcoin"
                android:textColor="#888888"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Price (Width: 90dp) -->
    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:text="$96,500.00"
        android:textColor="#111111"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- 1h Change (Width: 70dp) -->
    <TextView
        android:id="@+id/tvChange1h"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:text="+0.00%"
        android:textColor="#888888"
        android:textSize="11sp" />

    <!-- 8h Change (Width: 70dp) -->
    <TextView
        android:id="@+id/tvChange8h"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:text="+0.00%"
        android:textColor="#888888"
        android:textSize="11sp" />

    <!-- 24h Change (Width: 70dp) -->
    <TextView
        android:id="@+id/tvChange24h"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:text="+0.00%"
        android:textColor="#888888"
        android:textSize="11sp" />

    <!-- 7d Change (Width: 70dp) -->
    <TextView
        android:id="@+id/tvChange7d"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:text="+0.00%"
        android:textColor="#888888"
        android:textSize="11sp" />

</LinearLayout>
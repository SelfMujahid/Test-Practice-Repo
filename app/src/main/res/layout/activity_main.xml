<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 1. STICKY TOP HEADER -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/imgAppLogo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/app_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="TEST"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exchange"
            android:textColor="#00D4FF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. SCROLLABLE CONTENT BODY -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:layout_below="@id/topHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- SECTION A: DEMO BALANCE CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DEMO PORTFOLIO"
                        android:textColor="#777777"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/tvDemoBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="$10,000.00"
                        android:textColor="#111111"
                        android:textSize="28sp"
                        android:textStyle="bold"/>

                    <!-- Timeframe PnL Chips (Horizontal Scroll) -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/pnlChipsContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <!-- Chips dynamically loaded in Kotlin -->
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Top 5 Trades Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Top 5 Trades (Highest P&amp;L)"
                        android:textColor="#111111"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:id="@+id/topTradesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SECTION B: MARKET OVERVIEW STATS -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvGlobalMcap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF"
                        android:padding="8dp"
                        android:text="MCap: $2.4T"
                        android:textSize="11sp"
                        android:textColor="#111111"/>

                    <TextView
                        android:id="@+id/tvBtcDom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="#FFFFFF"
                        android:padding="8dp"
                        android:text="BTC Dom: 54.2%"
                        android:textSize="11sp"
                        android:textColor="#111111"/>

                    <TextView
                        android:id="@+id/tvEthDom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="#FFFFFF"
                        android:padding="8dp"
                        android:text="ETH Dom: 16.5%"
                        android:textSize="11sp"
                        android:textColor="#111111"/>

                    <TextView
                        android:id="@+id/tvAltDom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="#FFFFFF"
                        android:padding="8dp"
                        android:text="ALT Dom: 29.3%"
                        android:textSize="11sp"
                        android:textColor="#111111"/>

                    <TextView
                        android:id="@+id/tv24hVol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="#FFFFFF"
                        android:padding="8dp"
                        android:text="24h Vol: $85B"
                        android:textSize="11sp"
                        android:textColor="#111111"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- SECTION C: SEARCH & FILTERS -->
            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="#FFFFFF"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="8dp"
                android:hint="Search coin name or symbol..."
                android:paddingHorizontal="12dp"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAll"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="All"
                    android:textSize="11sp"/>

                <Button
                    android:id="@+id/btnGainers"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:text="🚀 Gainers"
                    android:textSize="11sp"/>

                <Button
                    android:id="@+id/btnLosers"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:text="📉 Losers"
                    android:textSize="11sp"/>
            </LinearLayout>

            <!-- TABLE HEADER -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#E0E0E0"
                        android:padding="10dp"
                        android:orientation="horizontal">

                        <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="#" android:textStyle="bold" android:textSize="11sp"/>
                        <TextView android:layout_width="120dp" android:layout_height="wrap_content" android:text="NAME" android:textStyle="bold" android:textSize="11sp"/>
                        <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="PRICE" android:gravity="end" android:textStyle="bold" android:textSize="11sp"/>
                        <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="1H %" android:gravity="end" android:textStyle="bold" android:textSize="11sp"/>
                        <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="8H %" android:gravity="end" android:textStyle="bold" android:textSize="11sp"/>
                        <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="24H %" android:gravity="end" android:textStyle="bold" android:textSize="11sp"/>
                        <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="7D %" android:gravity="end" android:textStyle="bold" android:textSize="11sp"/>
                    </LinearLayout>

                    <!-- RECYCLERVIEW FOR 300+ COINS -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/cryptoRecyclerView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>
                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 3. STICKY BOTTOM NAVIGATION BAR (Bitget Style) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        app:elevation="8dp"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>

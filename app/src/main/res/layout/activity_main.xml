<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- FIXED TOP HEADER WITH LOGO + 3 LINES -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentTop="true"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <RelativeLayout
            android:id="@+id/btnMenuLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <!-- Logo -->
            <ImageView
                android:id="@+id/imgAppLogo"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/app_logo" />

            <!-- 3 Lines Badge (Menu Icon overlay) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/imgAppLogo"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:text="≡"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Crypto Tracker"
            android:textColor="#111111"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SCROLLABLE BODY -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:layout_below="@id/topHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- DEMO BALANCE SECTION -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DEMO BALANCE"
                        android:textColor="#888888"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvDemoBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="$10,000.00"
                        android:textColor="#111111"
                        android:textSize="26sp"
                        android:textStyle="bold"/>

                    <!-- Real Timeframe PnL Chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/pnlChipsContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Top 5 Trades (Profit / Loss)"
                        android:textColor="#111111"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <!-- Real Trades Container or No Trades Message -->
                    <LinearLayout
                        android:id="@+id/topTradesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNoTrades"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No open trades (P/L: $0.00)"
                            android:textColor="#888888"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- STATS OVERVIEW BAR -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvGlobalMcap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF"
                        android:padding="8dp"
                        android:text="MCap: $2.6T"
                        android:textSize="11sp"
                        android:textColor="#111111"/>

                    <TextView
                        android:id="@+id/tvBtcDom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="#FFFFFF"
                        android:padding="8dp"
                        android:text="BTC Dom: 55.4%"
                        android:textSize="11sp"
                        android:textColor="#111111"/>

                    <TextView
                        android:id="@+id/tvEthDom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="#FFFFFF"
                        android:padding="8dp"
                        android:text="ETH Dom: 15.2%"
                        android:textSize="11sp"
                        android:textColor="#111111"/>

                    <TextView
                        android:id="@+id/tvAltDom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="#FFFFFF"
                        android:padding="8dp"
                        android:text="ALT Dom: 29.4%"
                        android:textSize="11sp"
                        android:textColor="#111111"/>

                    <TextView
                        android:id="@+id/tv24hVol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="#FFFFFF"
                        android:padding="8dp"
                        android:text="24h Vol: $92B"
                        android:textSize="11sp"
                        android:textColor="#111111"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- SEARCH BAR (WITH 70% SMALLER SEARCH ICON) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp">

                <!-- 70% Smaller Search Icon -->
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#888888" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:hint="Search crypto symbol..."
                    android:textColor="#111111"
                    android:textColorHint="#888888"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- FILTERS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAll"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="All"
                    android:textSize="11sp"
                    android:background="#E3F2FD"
                    android:textColor="#1976D2"/>

                <Button
                    android:id="@+id/btnGainers"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:text="🚀 Gainers"
                    android:textSize="11sp"
                    android:textColor="#888888"/>

                <Button
                    android:id="@+id/btnLosers"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:text="📉 Losers"
                    android:textSize="11sp"
                    android:textColor="#888888"/>
            </LinearLayout>

            <!-- TABLE WITH EXACT COLUMN ALIGNMENT -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- EXACT ALIGNED HEADER -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#EEEEEE"
                        android:paddingVertical="8dp"
                        android:orientation="horizontal">

                        <TextView android:layout_width="35dp" android:layout_height="wrap_content" android:text="#" android:textStyle="bold" android:textSize="11sp" android:textColor="#666666"/>
                        <TextView android:layout_width="120dp" android:layout_height="wrap_content" android:text="NAME" android:textStyle="bold" android:textSize="11sp" android:textColor="#666666"/>
                        <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="PRICE" android:gravity="end" android:textStyle="bold" android:textSize="11sp" android:textColor="#666666"/>
                        <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="1H %" android:gravity="end" android:textStyle="bold" android:textSize="11sp" android:textColor="#666666"/>
                        <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="8H %" android:gravity="end" android:textStyle="bold" android:textSize="11sp" android:textColor="#666666"/>
                        <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="24H %" android:gravity="end" android:textStyle="bold" android:textSize="11sp" android:textColor="#666666"/>
                        <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="7D %" android:gravity="end" android:textStyle="bold" android:textSize="11sp" android:textColor="#666666"/>
                    </LinearLayout>

                    <!-- RECYCLERVIEW FOR 300+ COINS -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/cryptoRecyclerView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>
                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FIXED BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        app:elevation="8dp"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
